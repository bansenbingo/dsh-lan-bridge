{
  "name": "dsh-lan-bridge",
  "version": "0.1.2",
  "private": true,
  "description": "Share conversations, memory, plugin lists and workspace files between two DSH machines on the same LAN.",
  "keywords": [
    "dsh",
    "plugin",
    "lan",
    "sync",
    "sidebar"
  ],
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "lib",
    "icon.svg",
    "README.md",
    "CHANGELOG.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "slots"
      ]
    }
  }
}
